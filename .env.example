# Required: PostgreSQL connection string (Neon, AWS RDS, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required: JWT signing secret (generate a strong random string)
JWT_SECRET=your-strong-random-secret-at-least-32-chars

# Optional: Owner credentials (defaults: owner@cafe.com / owner123)
OWNER_EMAIL=owner@cafe.com
OWNER_PASSWORD=owner123

# Optional: Frontend URL for CORS (defaults: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Optional: Port (defaults: 3000)
PORT=3000

# Optional: Set to "production" for secure cookies + caching
NODE_ENV=development
